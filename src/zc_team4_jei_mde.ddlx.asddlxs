  @EndUserText.label: 'G/L Account'
  @UI.lineItem: [{
    position: 20,
    importance: #HIGH
  }]
  @UI.fieldGroup: [{
    qualifier: 'ItemDetails',
    position: 10
  }]
  GLAccount;


  @EndUserText.label: 'G/L Account Name'
  @UI.lineItem: [{
    position: 30,
    importance: #MEDIUM
  }]
  GLAccountName;


  @EndUserText.label: 'Debit/Credit'
  @UI.lineItem: [{
    position: 40,
    importance: #HIGH
  }]
  @UI.fieldGroup: [{
    qualifier: 'ItemDetails',
    position: 20
  }]
  DebitCredit;


  @EndUserText.label: 'Amount'
