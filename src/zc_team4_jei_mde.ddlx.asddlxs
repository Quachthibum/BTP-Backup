@Metadata.layer: #CUSTOMER

@UI.headerInfo: {
  typeName: 'Journal Entry Item',
  typeNamePlural: 'Journal Entry Items'
}

annotate entity ZC_TEAM4_JEI with
{
  @UI.hidden: true
  JournalEntryUUID;


  @EndUserText.label: 'Item'
